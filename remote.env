# Settings pushed for you through the automatic updates (Claude can't log into the server).
# They win over .env while they're listed here. To use only your own .env settings instead:
#   sudo -u arbbot python3 /opt/arb-bot/arbbot.py --set REMOTE_SETTINGS=off && systemctl restart arbbot
#
# Flood mode (asked for Sun Oct 4): like Saturday, plus more pre-game and MLB playoff props. No hourly caps, no live
# two-check rule, no live price-age rule.
ALERT_MODE=balanced
# Pre-game +EV from 4% (Mon Oct 5: 3% edges were too common), medium confidence allowed (🟡, 25% smaller
# stake). Low confidence still skipped.
MIN_EV_PCT=4
MIN_CONFIDENCE=medium
# Oct 16: prop outliers (priced off the other books) beat the close 63% vs 86% for Pinnacle-priced props: 40% smaller.
OUTLIER_PROP_STAKE=0.6
MAX_EV_PER_HOUR=0
# Player props from 7%.
PROP_MIN_EV_PCT=7
# Props for NFL, NBA, NHL and MLB (playoffs). No college player props: New York's sportsbooks can't offer them. College
# football is checked per game too, but only for its first-half lines (see PROP_MARKETS).
PROP_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,americanfootball_ncaaf
MAX_PROP_PER_HOUR=0
# Arbs from 2% (live 3%); outliers from 10%, before the game only. Live outliers are off: in the 24 hours to
# Mon Oct 5 10pm they went 7-20 (MLB 4-9, NFL 2-7, NHL 1-4), their prices mostly gone within a check.
# OUTLIER_LIVE=true turns them back on.
MIN_PROFIT_PCT=2
MIN_LIVE_PROFIT_PCT=3
MAX_ARB_PER_HOUR=0
OUTLIER_MIN_PCT=10
OUTLIER_LIVE=false
# Oct 19: no NFL prop outliers. Priced off the median of just 3 other books they beat the close 16 of 60 times
# (Unders 10 of 47), while NFL props priced off Pinnacle beat it 18 of 30 (Unders 7 of 8). NFL props are back,
# Pinnacle-priced only. NFL game-line outliers stay.
# Oct 22: NBA too. Its prop outliers (3-4 book median) beat the close 36 of 70 times on the first two nights, while
# Pinnacle-priced NBA props beat it 26 of 42 (Unders 17 of 20) and wider consensus 6 of 6.
OUTLIER_PROP_OFF_SPORTS=americanfootball_nfl,basketball_nba
# Oct 24: no outliers at all, any sport, props or game lines. Over the last 14 days outliers (a book far off the other
# books' median) beat the close 46% of the time (221 bets, +2.0% CLV), Pinnacle-priced bets 83% (444, +5.5%), a wide
# consensus of books 97% (30). Every alert is now priced off Pinnacle or that consensus.
OUTLIERS_ENABLED=false
MAX_OUTLIER_PER_HOUR=0
# Live: no hourly limit, no waiting for a second check, no price-age limit (as on Saturday).
LIVE_PER_HOUR=0
LIVE_CONFIRM_CHECKS=1
LIVE_MAX_AGE_ALERT=0
#
# The $119 plan (5,000,000 credits a month), upgraded Mon Oct 5 ("add all the extra perks"). These checks would
# use up a 100,000-credit plan in days.
#
# Sports: the five you had, plus men's college basketball. Its season starts in November; until its games are on
# the schedule it costs nothing. As in college football: a college +EV bet still needs a 6% edge (an outlier, like
# any other, needs 10% against the other books and 4% against Pinnacle's price when Pinnacle has one), and New
# York's sportsbooks are left out of games with a New York college team (Kalshi still counts).
# (Soccer was added Oct 9 and taken out Oct 10, to pay for first-half and first-quarter lines.)
# Oct 11: plus MMA (UFC and other cards): fight moneylines against Pinnacle, graded from ESPN's UFC results.
# Oct 15: MLB dropped until next season (props beat the close only 32% Oct 11-14, -11% return overall). To bring it
# back (late March): add baseball_mlb to SPORTS and PROP_SPORTS; its PROP_MARKETS entry is still below.
SPORTS=americanfootball_nfl,americanfootball_ncaaf,basketball_nba,icehockey_nhl,basketball_ncaab,mma_mixed_martial_arts
# If credits get tight (the next 24 hours can't be checked at full speed), MMA is dropped first, back once there's room.
SHED_SPORTS=mma
# The plan's size, and the day of the month its credits reset: the 1st at midnight UTC (Odds API account page),
# not the invoice date. The bot reads the credits left from every answer; these only set how it spreads them out.
MONTHLY_CREDITS=5000000
BILLING_DAY=1
# Warn in the health channel when fewer than 250,000 credits are left.
LOW_CREDITS=250000
# How the month's credits are shared across the week. NBA, NHL and college basketball play every night, so
# weekdays get almost as much as weekends now (was mon 1.2, tue 0.6, wed 0.6, thu 1.2, fri 1, sat 2, sun 2.2).
BUDGET_WEIGHTS=mon=1,tue=1,wed=1,thu=1,fri=1.1,sat=1.3,sun=1.3
# Live games: every 40 seconds. The Odds API refreshes live odds every 40 seconds, so checking faster brings
# nothing new.
POLL_SECONDS=40
# Every game in the next 48 hours: moneylines, spreads and totals every minute (the Odds API refreshes them
# every minute before games). One check covers every game of a sport: 3 credits.
PREGAME_MINUTES=1
EARLY_MINUTES=1
FAR_MINUTES=1
LOOKAHEAD_HOURS=48
# No speed-ups from spare credits: they would plan to spend most of the plan. Each floor is the pace above.
PREGAME_MIN_MINUTES=1
EARLY_MIN_MINUTES=1
FAR_MIN_MINUTES=1
# Player props: every 3 minutes in the last 8 hours before the game (Oct 9: was every 5 minutes in the last 12; prop
# prices move most near kickoff, and this costs about the same), every 30 minutes from 48 hours out.
# Oct 15: props checked 3x as often (a quarter of NHL prop prices were gone by the next check; credits ~11% used).
PROP_MINUTES=1
PROP_NEAR_MIN_MINUTES=1
PROP_HOURS=8
PROP_EARLY_MINUTES=10
PROP_EARLY_MIN_MINUTES=10
PROP_EARLY_HOURS=48
# Prop types, each with its alternate lines (the "_alternate" ones), on every check. A prop type no book has
# posted yet costs nothing; each one with prices costs 1 credit per game per check.
# NFL: passing yards, TDs, completions, attempts and interceptions; rushing yards and attempts; receptions;
# receiving yards; rushing + receiving yards; anytime TD; rushing TDs and receiving TDs (Oct 9). Also (Oct 9): longest
# rush and reception, passing + rushing yards, passing + rushing + receiving yards and TDs, and the kicker's field
# goals, extra points and points. (Defense props are left out on purpose; the bot can grade them if they're added.)
# NBA: points, rebounds, assists, threes, the four combos (points+rebounds+assists, points+rebounds,
# points+assists, rebounds+assists), blocks, steals, blocks+steals, turnovers; field goals made, free throws made
# and attempted, double-double and triple-double (Oct 9).
# NHL: points, shots on goal, assists, goals, goalie saves, blocked shots, anytime goal scorer.
# MLB: hits, total bases, home runs, RBIs, runs, walks, batter strikeouts (Oct 9), hits+runs+RBIs; pitcher strikeouts,
# outs, earned runs,
# hits allowed and walks.
# Oct 10, first half and first quarter, priced against Pinnacle like full-game lines (same bars, 6% in college), graded
# from the box score's period scores. NFL and NBA: 1st half moneyline, spread and total; 1st quarter spread and total.
# College football: 1st half moneyline, spread and total. They come with each game's prop check (1 credit each).
# If the Odds API ever turns one down, only that one stops (until a restart) and the health channel says which.
# Oct 16: cut the prop markets that produced no bets since Oct 3 (NFL kickers, combo yards/TDs, rushing/receiving TDs,
# 1st-quarter lines; NHL blocked shots and goals): their credits go to checking the rest faster.
# Oct 25: NBA moneylines and spreads for every half and quarter too (1Q moneyline, 2nd half, 2nd-4th quarters),
# graded from the box score's period scores like the first half. Books post few of the later ones before tip-off.
# Oct 25: NFL moneylines and spreads for all four quarters, and NHL moneyline, puck line and total for each
# period (a period bet never counts overtime; a tied period is a Draw on a 3-way moneyline, else refunded).
PROP_MARKETS=americanfootball_nfl=player_pass_yds|player_pass_tds|player_pass_completions|player_pass_attempts|player_pass_interceptions|player_rush_yds|player_rush_attempts|player_receptions|player_reception_yds|player_rush_reception_yds|player_anytime_td|player_rush_longest|player_reception_longest|player_pass_yds_alternate|player_pass_tds_alternate|player_pass_completions_alternate|player_pass_attempts_alternate|player_rush_yds_alternate|player_rush_attempts_alternate|player_receptions_alternate|player_reception_yds_alternate|player_rush_reception_yds_alternate|player_rush_longest_alternate|player_reception_longest_alternate|h2h_h1|spreads_h1|totals_h1|h2h_q1|spreads_q1|h2h_q2|spreads_q2|h2h_q3|spreads_q3|h2h_q4|spreads_q4;basketball_nba=player_points|player_rebounds|player_assists|player_threes|player_points_rebounds_assists|player_points_rebounds|player_points_assists|player_rebounds_assists|player_blocks|player_steals|player_blocks_steals|player_turnovers|player_field_goals|player_frees_made|player_frees_attempts|player_double_double|player_triple_double|player_points_alternate|player_rebounds_alternate|player_assists_alternate|player_threes_alternate|player_points_rebounds_assists_alternate|player_points_rebounds_alternate|player_points_assists_alternate|player_rebounds_assists_alternate|player_blocks_alternate|player_steals_alternate|player_turnovers_alternate|h2h_h1|spreads_h1|totals_h1|spreads_q1|totals_q1|h2h_q1|h2h_h2|spreads_h2|h2h_q2|spreads_q2|h2h_q3|spreads_q3|h2h_q4|spreads_q4;icehockey_nhl=player_points|player_shots_on_goal|player_assists|player_total_saves|player_goal_scorer_anytime|player_points_alternate|player_shots_on_goal_alternate|player_assists_alternate|player_total_saves_alternate|h2h_p1|spreads_p1|totals_p1|h2h_p2|spreads_p2|totals_p2|h2h_p3|spreads_p3|totals_p3;baseball_mlb=batter_hits|batter_total_bases|pitcher_strikeouts|batter_home_runs|batter_rbis|batter_runs_scored|batter_walks|batter_strikeouts|batter_hits_runs_rbis|pitcher_outs|pitcher_earned_runs|pitcher_hits_allowed|pitcher_walks|batter_hits_alternate|batter_total_bases_alternate|batter_rbis_alternate|batter_runs_scored_alternate|batter_home_runs_alternate|batter_walks_alternate|batter_hits_runs_rbis_alternate|batter_strikeouts_alternate|pitcher_strikeouts_alternate;americanfootball_ncaaf=h2h_h1|spreads_h1|totals_h1
# NHL goals and saves and the NFL alternate lines are in the list above now.
# Oct 11: NFL and NBA team totals (a team's own points, over/under) in the last 8 hours before the game, only on days
# that fit the budget at full speed with them (PROP_NEAR_SPARE_ONLY): when credits get tight, they're the first to go.
PROP_NEAR_MARKETS=icehockey_nhl=;americanfootball_nfl=team_totals;basketball_nba=team_totals
PROP_NEAR_SPARE_ONLY=true
# At most 8 games' props per pass, the most overdue first (the rest follow seconds later), so a slate of games
# starting together doesn't hit the Odds API all at once or hold up the next live check.
PROP_MAX_PER_PASS=20
# A +EV or outlier card already posted is refreshed at most every 10 minutes when only other books' prices or
# notes change (Discord limits how fast the bot can edit). A new price or stake for your bet, a GONE mark, a much
# better price (new alert) and live cards: right away. (With ONE_ALERT_PER_BET below, cards stay as they went out.)
CARD_EDIT_MIN_SECONDS=600
#
# EV BOT changes (Oct 8, 2026):
# No arbs at all, main lines or props (a price gap that's also a +EV bet still goes out as +EV).
ARBS_ENABLED=false
# One alert per bet: never again at a better price, at another book, as an outlier, or after a restart. The card
# isn't edited after it goes out, except to mark it GONE.
ONE_ALERT_PER_BET=true
# Results: one card per finished New York day, between 12:30 and 1:00am. Nothing as bets settle.
RESULTS_DAILY_ONLY=true
# Each new +EV, prop, outlier and parlay card pings the Discord role of the book it's at, and only that role
# (no more @everyone on outliers). Edits never ping.
BOOK_ROLES=DraftKings=1557947182290837534,FanDuel=1557947301568184483,BetMGM=1557947490681225256,Caesars=1557947688731934750,Kalshi=1557947752770441356
# Caesars paused (Oct 18): only 8 bets in two weeks. No new alerts there; its past bets stay in the results.
# Oct 21: DraftKings and FanDuel only for now: every other book paused (BetMGM, Kalshi, ESPN BET, BetRivers,
# Fanatics, Hard Rock). Their prices still count toward fair odds and the market median; past bets stay in the results.
PAUSED_BOOKS=williamhill_us,betmgm,kalshi,espnbet,betrivers,fanatics,hardrockbet
# Tuning from the bot's own record, by book and sport (Oct 9): a book whose price is usually gone by the next check
# needs 2 more points of edge; one that clearly beats the closing line gets 25% bigger stakes, one that clearly
# loses to it half. Nothing changes until there are enough bets (30 for prices, 50 for CLV).
TUNE_ENABLED=true
# Tuning only learns from bets alerted from Oct 9 on: before the Oct 8 fix, BetMGM's NHL points props were priced like
# goals props, which made BetMGM and the NHL look far better than they are.
TUNE_SINCE=2026-10-09
#
# Oct 10: bets on one game win and lose together. The first 2 alerts on a game at full stake, the 3rd and 4th at half,
# no more than 4 per game (game lines and props together).
SAME_GAME_FULL=2
SAME_GAME_MAX=4
# Oct 12: player props count per player, not per game (on a Sunday the game limit cut most NFL props to $10).
# A player's 1st prop at full stake, a 2nd at half, no 3rd. Game lines (and team totals) keep the game limit above.
SAME_PLAYER_FULL=1
SAME_PLAYER_MAX=2
# Oct 15: no more piles of the same side in one game (e.g. 4 players' Under 0.5 Hits): 1 at full stake, a 2nd at a
# smaller stake, none after that, per game, stat and side (Over/Under).
SAME_SIDE_FULL=1
SAME_SIDE_MAX=2
# The public results page lives here (GitHub Pages). Its token is on the server only (--set RESULTS_SITE_TOKEN=...).
RESULTS_SITE_REPO=joeybuffo10-wq/ev-bot-results
# Oct 15: members see the results page at buffbets.github.io/results (a copy reading the same results.json).
RESULTS_SITE_URL=https://buffbets.github.io/results/
# FanDuel and DraftKings parlay cards get one link with every leg in the bet slip. FanDuel's web link opens its app.
# DraftKings' web links open its website logged out, so its link is the app's own (dksb://, through the results site's
# go.html), legs joined with an encoded plus: tested on a phone Oct 11, both legs in the slip ("app-plus" works too).
# Oct 20: up to 6 parlays up at once (was 3), built from the best 12 legs per book (was 8): every leg in one
# slip only now (no leg shared by two parlays or a boosts pick), so more slips need more room.
PARLAY_MAX_ALERTS=6
PARLAY_LINK_BOOKS=fanduel,draftkings
PARLAY_DK_FORMAT=app-encoded
# Oct 26: more parlays (#more-parlays) like the profit boost picks: 3 legs, each at least fair against the sharp
# line and +10% EV or more on its own, 1 unit each, up to 15 at once (was 10).
MORE_PARLAYS_LEGS=3
MORE_PARLAYS_LEG_MIN_EV_PCT=10
MORE_PARLAYS_MIN_EV_PCT=6
MORE_PARLAYS_UNITS=1
MORE_PARLAYS_MAX=15
#
# Oct 11: "⏰ Starts soon" on still-good cards 30 minutes before the game; a 10am digest of the bets still good; a
# copy-ready weekly post on Mondays. The free preview channel (its webhook is on the server) gets each winning player
# prop once it's graded, nothing else.
LAST_CALL_MINUTES=30
DIGEST_HOUR=10
SOCIAL_WEEKLY=true
# Oct 12: the top picks get their own channel (its webhook is on the server): every 💎 Elite bet (70%+ to win, Pinnacle's
# own price, high confidence) goes there instead of the bets channel, no daily limit. Nothing else goes there.
TOP3=true
TOP_PICKS=5
# Oct 16: tier roles members pick for themselves; a card pings its tier role along with its book role.
TIER_ROLES=elite=1560644763667927192,very=1559344768578752542,confident=1559344981901312041,somewhat=1559345064835031087,slight=1559345291180904448
# Oct 15: profit boosts. "!boost 50 fanduel" in #units DMs the best bets for that boost; at noon the best ones for
# 25/50/100% boosts at FanDuel and DraftKings go to the #boosts channel (its webhook is on the server: --set-webhook boosts).
BOOSTS_HOUR=12
# Oct 13: 💵 unit DMs. Members type "!unit 25" in #units; tapping 💵 under a bet card DMs them its stake at their unit.
UNIT_CHANNEL_ID=1559582877941760020
# Oct 13: paid members + referrals from Stripe (the key is on the server). 14-day free trial on the checkout; $45/month since Oct 13 (the old $20 link is off).
STRIPE_PAYMENT_LINK=plink_1UQ9qA6n79tiIofCCe1ws3ff
STRIPE_SIGNUP_URL=https://buy.stripe.com/4gM00c31W93A8xCcR80x201
JOIN_SITE_URL=https://buffbets.github.io
# Under the free preview channel's posts:
FREE_CTA=🔓 Members got these before the game. Get every alert, 14 days free: <https://buy.stripe.com/4gM00c31W93A8xCcR80x201>
# Oct 15: once a week (Saturdays from noon) the first 🟢/🔵 +EV alert also goes to the free preview channel, live, as a
# labeled free sample with the trial link (💎 Elite stays members-only).
FREE_SAMPLE_DAY=sat
FREE_SAMPLE_HOUR=12
PAID_ROLE_ID=1559607928951013446
# Oct 14: Kalshi bets beat the close only 35% of the time (17 bets; every other book ~80-90%): 3 more points of edge.
BOOK_EXTRA_EDGE=kalshi=3
# Oct 24: NBA prop Overs need 3 more points of edge (10%; Unders stay at 7%): Pinnacle-priced NBA Overs beat the close
# 9 of 22 times, the Unders 17 of 20.
SIDE_EXTRA_EDGE=basketball_nba:over=3
# Oct 15: NFL player props beat the close only ~55% Oct 11-14 (Pinnacle prices few of them): they needed 10% edge.
# Oct 23: back to 7% like every sport. The losers were the 3-book outliers (off since Oct 19); Pinnacle-priced NFL props
# beat the close 18 of 30, and at 10% with no outliers none went out Oct 20-22. Back to 10 if they slip under ~60%
# (PROP_SPORT_MIN_EV=americanfootball_nfl=10).
# Oct 15: NHL shots on goal: 105 bets, 94% beat the close, +24.9% return: stakes ×1.25 (capped at the usual max).
STAKE_BOOST=icehockey_nhl:player_shots_on_goal=1.25
